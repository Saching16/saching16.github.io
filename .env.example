# Copy to .env and fill in. .env is gitignored.

# Required for the Digital Twin chat (app/api/digital-twin) and for the
# AI change summary in scripts/summarize-rag-changes.mjs.
OPENAI_API_KEY=

# Optional. Salt for hashing client IPs in chat analytics logs.
CHAT_ANALYTICS_SALT=

# Dev only. Set to 1 so `npm run eval-twin` is not slowed by the chat rate limit.
# Ignored when NODE_ENV is production, including `next start` and Vercel.
DISABLE_RATE_LIMIT=

# Only needed to run `npm run fetch-drive` locally.
# Full JSON key of a Google service account with Viewer access to the folder.
GOOGLE_SERVICE_ACCOUNT_JSON=
# From drive.google.com/drive/folders/<folder id>
GOOGLE_DRIVE_FOLDER_ID=
